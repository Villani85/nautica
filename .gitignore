# --- ROBA CHE NON APPARTIENE AL REPO
#
# Binari di terze parti scaricati da uno strumento (KTX-Software, 5,6 MB): lo
# strumento sa trovarli da solo in quattro posti diversi, e versionarli
# significherebbe portarsi dietro un eseguibile Windows dentro un repo che
# altrove pesa i chunk al decimo di KB.
riferimenti/ktx2/attrezzo/

# Uscite intermedie delle cotture e dei provini: si rigenerano con un comando,
# e sono megabyte di PNG e .blend. Il patto di questo repo e' che si versiona
# CIO' CHE PRODUCE, non cio' che e' stato prodotto -- tranne i beni che il sito
# serve davvero, che stanno in public/.
riferimenti/blender/uscite/
riferimenti/blender/provino/uscita/
riferimenti/ktx2/uscita/
riferimenti/ktx2/provino/

# Blender lascia i .pyc degli script eseguiti con -P
riferimenti/blender/__pycache__/
# la geometria esportata si rigenera con esporta-meccanismo.mjs
riferimenti/blender/meccanismo.json

# L HDRI e un ingresso di cottura, non un pezzo del sito: 7 MB che non
# vanno spediti a nessuno. Si riscarica con riferimenti/blender/hdri/DOVE.md
riferimenti/blender/hdri/*.hdr
meccanismo.json

# L'ambiente del sito esportato per Blender: DERIVATO, e va rigenerato ogni
# volta con `node strumenti/esporta-ambiente.mjs`. Committarlo significherebbe
# che, cambiando la tavolozza in `stile.css`, il confronto con Cycles
# continuerebbe a girare su un cielo vecchio senza dirlo -- e un confronto che
# misura due mondi diversi senza accorgersene e' il difetto piu' caro di questo
# pass. `cuoci.py` si ferma con un errore se manca.
riferimenti/blender/hdri/ambiente-sito.png
uscite/
cucitura-traversata/

# le worktree di lavoro non sono il progetto
.claude/worktrees/
